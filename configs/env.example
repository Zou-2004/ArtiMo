# Copy to .env or export these variables in your shell.

# Model/API configuration.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional OpenAI-compatible endpoint override.
OPENAI_BASE_URL=
AZURE_OPENAI_ENDPOINT=

# Rendering/runtime defaults.
CODEX_LOOP_MOTION_RENDER_BACKEND=blender
CODEX_BLENDER_USE_GPU=1
CODEX_BLENDER_PERSISTENT=1
CODEX_TORCH_RASTER=1
CODEX_PYTORCH3D_VIS_RASTER=1
CODEX_TORCH_RASTER_ALLOW_CPU=1

# Optional external executables.
BLENDER_BIN=/path/to/blender
ISAAC_PYTHON=/path/to/isaacsim/python.sh
